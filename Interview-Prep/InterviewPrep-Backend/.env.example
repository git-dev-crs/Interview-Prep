# ─── InterviewPrep Backend — Environment Variables ────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it is in .gitignore.

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?appName=Interview-Prep

# Server port
PORT=3001

# JWT secret — generate a strong random string (e.g. openssl rand -hex 32)
JWT_SECRET=your_jwt_secret_here

# Google Generative AI (Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest

# Google OAuth Client ID
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Frontend origin (for CORS + password-reset links)
CLIENT_URL=http://localhost:3000

# ─── SMTP — Real password-reset emails via Gmail ──────────────────────────────
# Create a Gmail App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_16_char_app_password
MAIL_FROM="InterviewPrep <your@gmail.com>"
